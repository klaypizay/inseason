SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
RAFTER_API_KEY=YOUR_RAFTER_API_KEY
DATABASE_URL=postgresql://season_coach_app:YOUR_RUNTIME_PASSWORD@HOST:5432/postgres
MIGRATION_DATABASE_URL=postgresql://MIGRATION_USER:YOUR_MIGRATION_PASSWORD@HOST:5432/postgres
DATABASE_SSL=true
# Optional path to the server root certificate downloaded from Supabase.
DATABASE_CA_CERT_FILE=prod-ca-2021.crt
SEED_COACH_A_ID=MANAGED_AUTH_USER_UUID_A
SEED_COACH_B_ID=MANAGED_AUTH_USER_UUID_B

# M2: fixture is free and deterministic; openai enables live structured drafts.
COACH_AI_PROVIDER=fixture
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
COACH_AI_DAILY_LIMIT=30
